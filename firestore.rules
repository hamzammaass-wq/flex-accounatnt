rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Subscription Admins ────────────────────────────────
    match /subscription_admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Workspace Subscriptions ────────────────────────────
    match /workspace_subscriptions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Company Subscriptions ──────────────────────────────
    match /company_subscriptions/{companyId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ─── Subscription Activation Codes ──────────────────────
    match /subscription_activation_codes/{codeId} {
      // Any authenticated user can read (to redeem a code)
      allow read: if request.auth != null;
      // Any authenticated user can write (admins create, users consume)
      allow write: if request.auth != null;
    }

    // ─── Workspace Offer Codes ──────────────────────────────
    match /workspace_offer_codes/{codeId} {
      // Any authenticated user can read (to redeem a code)
      allow read: if request.auth != null;
      // Any authenticated user can write (admins create, users mark as USED)
      allow write: if request.auth != null;
    }

    // ─── Workspace Sync Snapshots ───────────────────────────
    match /workspace_sync_snapshots/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ─── Billing Events (server-side writes, client reads) ──
    match /billing_events/{eventId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── Billing Checkout Requests ──────────────────────────
    match /billing_checkout_requests/{requestId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ─── Account Deletion Requests ──────────────────────────
    match /account_deletion_requests/{requestId} {
      allow read: if request.auth != null && request.auth.uid == requestId;
      allow create: if request.auth != null && request.auth.uid == requestId;
    }
  }
}
