# Server Port
PORT=5000

# PostgreSQL Database Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_account?schema=public

# SSL Connection to database (true/false) - Set to true for Supabase, Render, Neon, AWS RDS
DB_SSL=false

# Firebase Project Configuration
VITE_FIREBASE_PROJECT_ID=smart-account-cc181

# Bypass Firebase Auth for local development only. Keep false unless explicitly testing locally.
BYPASS_AUTH=false


# Google Application Credentials (JSON path) - Required for production authentication verification
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# Paddle Billing Configuration (server-side secret; never commit a real value or expose it as VITE_*)
PADDLE_API_KEY=

